# Copy to .env.local (gitignored) to configure a build. Everything here is
# compiled into the public static bundle: never put secrets in it.

# RPC endpoint: one URL, or comma-separated "label=url" entries (the first is
# the default; the footer lets users pick another). Default: the public RPC of
# the cluster below (https://api.devnet.solana.com for devnet,
# https://api.mainnet-beta.solana.com for mainnet).
# MAINNET: Solana's public mainnet RPC rate-limits hard and is not meant for
# production; the build warns when a mainnet build uses it. For a real
# deployment, put a dedicated mainnet endpoint first, e.g.
#   VITE_RPC_URL=main=https://<your-provider>/?api-key=<key restricted to your domain>
# The Content-Security-Policy connect-src is generated from exactly this list
# (plus the websocket each endpoint implies), so the site cannot reach any
# other host. https only (http for loopback). An API key in a URL becomes
# public: use a key restricted to your domain. Public endpoints rate-limit;
# use a dedicated one for real use.
VITE_RPC_URL=https://api.devnet.solana.com

# Cluster the app targets: mainnet | devnet | localnet (default: devnet).
# The program ids are the same on every cluster. On mainnet the Launch page
# shows "Launches open soon" until the launchpad's protocol is initialized
# there (docs/MAINNET.md); the Vault, Shield and Verify work meanwhile.
# Selects the cluster byte of the PQ vault key derivation (SPEC section 3), so
# vault keys differ per cluster, and the explorer links. The build refuses a
# well-known public endpoint of another cluster, and the app checks the
# endpoint's genesis hash at runtime: on a mismatch it refuses every
# transaction.
VITE_NOISED_CLUSTER=devnet

# "1" builds the SIMULATED-CHAIN demo (src/lib/mock) instead of the live
# @noisedlabs/sdk backend, for UI work without a cluster: nothing is sent to any
# RPC and no wallet is asked to sign. Leave unset for every real build; a live
# build fails if any simulated-chain code ends up in its bundle.
# VITE_NOISED_MOCK=1

# "off" removes ws://localhost:* from connect-src. It is only needed for the
# Solana Mobile Wallet Adapter (Android browsers talking to a wallet app).
VITE_NOISED_CSP_MWA=on

# Build output directory (default ./dist). It is emptied before every build,
# so its name must contain "dist". Set it in .env.local to build elsewhere,
# e.g. NOISED_OUT_DIR=D:/builds/noised-app-dist to build on another drive.
# NOISED_OUT_DIR=dist
